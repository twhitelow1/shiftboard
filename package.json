{
  "name": "shiftboard",
  "version": "1.0.0",
  "description": "Restaurant shift scheduling: job codes, shift swaps with manager approval, forecasting, and BEO event staffing.",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
    "dev:demo": "SEED_DEMO=true npm run dev",
    "build": "vite build",
    "build:demo": "DEMO=1 vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "db:import-sqlite": "node scripts/import-sqlite.js",
    "vapid-keys": "node scripts/vapid-keys.js",
    "build:app": "cd mobile && npm ci --no-audit --no-fund && WEB_BASE_URL=/app EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 npx expo export --platform web --output-dir ../dist/app"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@simplewebauthn/server": "14.1.0",
    "@vercel/functions": "^3.11.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@simplewebauthn/browser": "14.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "0.1.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "private": true
}
