{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && npm run build:app",
  "outputDirectory": "dist",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/@electric-sql/**,web/**,test/**,mobile/**,docs/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/toast",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/adp",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/tripleseat",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/announcements",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/errors-digest",
      "schedule": "15 13 * * *"
    },
    {
      "path": "/api/cron/opentable",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/reviews",
      "schedule": "45 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/sms-opt-in",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api"
    },
    {
      "source": "/platform",
      "destination": "/platform.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
